# Copie para .env e preencha. Nunca comite o .env (o repositório é público).

# Postgres. Na Vercel, a integração com Neon cria DATABASE_URL (pooler)
# e DATABASE_URL_UNPOOLED (direta, usada nas migrações) sozinha.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5433/postgres?sslmode=disable"
# DATABASE_URL_UNPOOLED=""

# Senha de acesso ao app. Use algo longo.
APP_PASSWORD=""

# Chave para assinar o cookie de sessão. Gere com:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""
